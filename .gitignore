# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local AI assistant tooling — installed via `uipro init`, not source.
# Re-installable on any machine via `npm i -g uipro-cli && uipro init --ai claude`
.claude/skills/
.claude/worktrees/
.claude/launch.json
.agent/
.codebuddy/
.codex/
.continue/
.cursor/
.gemini/
.github/prompts/
.kiro/
.opencode/
.qoder/
.roo/
.trae/
.windsurf/

# clerk configuration (can include secrets)
/.clerk/
