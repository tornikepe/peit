# ──────────────────────────────────────────────────────────────────────────
#  Peit — environment template
# ──────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env.local` (development) or set in your hosting
#  provider's dashboard (production).  Sections are ordered by how soon
#  you'll need them when bringing a new environment online.
#
#  Anything marked OPTIONAL has a graceful fallback — the surrounding
#  feature degrades cleanly when the variable is missing.  Anything
#  marked REQUIRED is checked at runtime and will surface a 503 in API
#  routes or an obvious UI error.
# ──────────────────────────────────────────────────────────────────────────


# ─── 1. Public site URL ───────────────────────────────────────────────────
# Used by email links, the widget loader, OAuth callbacks, and OG tags.
# Strip the trailing slash — code re-adds it where needed.
NEXT_PUBLIC_APP_URL=https://peit.ge


# ─── 2. Auth — Clerk (REQUIRED) ───────────────────────────────────────────
# https://dashboard.clerk.com → API Keys.  Use the test keys for dev,
# the production keys for prod (Clerk requires a separate instance for
# each).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Where Clerk redirects after each auth event.  These already match the
# routes in the codebase — change only if you fork the auth layout.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard


# ─── 3. Database — Postgres (REQUIRED in prod, optional in dev) ───────────
# Any Postgres ≥14 with the `vector` extension installed.  Recommended:
# Neon (free tier includes pgvector) or Supabase.  Without DATABASE_URL,
# the app falls back to localStorage in the browser — useful for local
# experiments but unsuitable for paid customers.
DATABASE_URL=postgresql://user:password@host:5432/peit


# ─── 4. AI tier — Anthropic Claude (OPTIONAL but recommended) ─────────────
# Required for the "AI" answer tier (the chatbot generates grounded
# responses from your knowledge base).  Without this key the answer
# engine falls through to keyword search.
# https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx


# ─── 5. Retrieval — Voyage AI embeddings (OPTIONAL) ───────────────────────
# Required for pgvector semantic search of knowledge chunks.  Without
# this key, the answer engine retrieves chunks by keyword instead.
# https://www.voyageai.com → API Keys.  200M tokens/month free.
VOYAGE_API_KEY=pa-xxxxxxxxxxxx


# ─── 6. Payments — Lemon Squeezy (REQUIRED for paid plans) ────────────────
# Lemon Squeezy is a Merchant of Record — they handle global VAT.
# https://app.lemonsqueezy.com → Settings → API.
LEMONSQUEEZY_API_KEY=lsq_xxxxxxxxxxxx
LEMONSQUEEZY_STORE_ID=12345

# Webhook secret — set this in the LS webhook configuration AND here.
# Webhooks are HMAC-verified server-side, so a wrong secret silently
# rejects every event.
LEMONSQUEEZY_WEBHOOK_SECRET=lsq_webhook_xxxxxxxx

# Variant IDs for each plan.  Create the product in LS, then copy each
# variant ID from the product page.  Without these the checkout API
# returns VARIANT_NOT_CONFIGURED.
LEMONSQUEEZY_VARIANT_BASIC=12345
LEMONSQUEEZY_VARIANT_PRO=12346
LEMONSQUEEZY_VARIANT_ULTIMATE=12347


# ─── 7. Transactional email — Resend (OPTIONAL but recommended) ───────────
# Without RESEND_API_KEY: welcome/lead/billing/trial emails are silently
# skipped — the app keeps working, customers just don't get notified.
# https://resend.com → API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxx

# Verified sender for the From header.  In dev you can omit this and
# the code falls back to onboarding@resend.dev (sandbox-only — Resend
# blocks delivery to addresses you haven't manually verified).  In prod
# this must be a verified domain you control.
RESEND_FROM=Peit Team <hi@peit.ge>


# ─── 8. Email unsubscribe HMAC (OPTIONAL) ─────────────────────────────────
# One-click unsubscribe links are HMAC-signed so we don't need a DB
# lookup to verify them.  If you don't set this, the code derives a key
# from CLERK_SECRET_KEY — fine for getting started, but rotating Clerk
# keys would then invalidate every outstanding link.  Set this in prod
# so the two secrets stay decoupled.
UNSUBSCRIBE_SECRET=long-random-string-at-least-32-chars


# ─── 9. Cron auth (REQUIRED in prod) ──────────────────────────────────────
# Gates the daily trial-reminder job.  Vercel cron sends both the
# Authorization header AND the ?secret= query string — either is
# accepted.  Skip this in dev and the endpoint is open (so you can hit
# it manually from a terminal).
CRON_SECRET=long-random-string


# ─── 10. Observability (OPTIONAL) ─────────────────────────────────────────
# When SENTRY_DSN is set, the app reports unhandled errors to Sentry.
# Without it errors stay in Vercel function logs.
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx


# ─── Node env ─────────────────────────────────────────────────────────────
# Set automatically by Vercel.  Override locally if you want to test
# production-mode behaviour (e.g. CSP, cron auth) on your laptop.
# NODE_ENV=production
